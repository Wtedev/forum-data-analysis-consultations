generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum CurrentStage {
  INDIVIDUAL
  RESEARCHER
  EMPLOYEE
  BUSINESS_OWNER
  OTHER
}

enum ConsultationType {
  STATISTICAL_ANALYSIS
  DATA_CLEANING
  DASHBOARDS_AND_REPORTS
  SURVEY_DESIGN
  TOOL_SELECTION
  RESULTS_INTERPRETATION
  OTHER
}

enum PreferredContactMethod {
  WHATSAPP
  CALL
  MEETING
}

enum ConsultationStatus {
  NEW
  IN_REVIEW
  CONTACTED
  ANSWERED
  NEEDS_FOLLOW_UP
  CLOSED
}

enum Priority {
  NORMAL
  MEDIUM
  HIGH
}

enum AdminRole {
  ADMIN
  CONSULTANT
  VIEWER
}

model Consultation {
  id                     String                 @id @default(cuid())
  referenceCode          String                 @unique
  fullName               String
  phone                  String
  email                  String?
  gender                 Gender
  currentStage           CurrentStage
  university             String?
  majorInterest          String?
  consultationType       ConsultationType
  tools                  String[]               @default([])
  question               String
  link                   String?
  preferredConsultant    String                 @default("NO_PREFERENCE")
  preferredContactMethod PreferredContactMethod
  status                 ConsultationStatus     @default(NEW)
  priority               Priority               @default(NORMAL)

  assignedToId           String?
  assignedTo             AdminUser?             @relation("AssignedConsultations", fields: [assignedToId], references: [id])

  notes                  ConsultationNote[]
  activityLogs           ActivityLog[]
  notifications          Notification[]

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  closedAt               DateTime?

  @@index([phone])
  @@index([fullName])
  @@index([email])
  @@index([status])
  @@index([consultationType])
  @@index([createdAt])
}

model AdminUser {
  id                     String                 @id @default(cuid())
  name                   String
  email                  String                 @unique
  passwordHash           String
  role                   AdminRole              @default(CONSULTANT)
  consultantKey          String?                @unique

  assignedConsultations  Consultation[]          @relation("AssignedConsultations")
  notes                  ConsultationNote[]
  activityLogs           ActivityLog[]
  invitesSent            ConsultantInvite[]

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model ConsultantInvite {
  id            String    @id @default(cuid())
  email         String
  name          String
  consultantKey String
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdById   String?
  createdBy     AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([consultantKey])
}

model ConsultationNote {
  id             String        @id @default(cuid())
  consultationId String
  adminUserId    String
  note           String

  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  adminUser      AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  createdAt      DateTime      @default(now())

  @@index([consultationId])
  @@index([adminUserId])
}

model ActivityLog {
  id             String        @id @default(cuid())
  adminUserId    String?
  consultationId String?
  actionType     String
  description    String

  adminUser      AdminUser?    @relation(fields: [adminUserId], references: [id])
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())

  @@index([consultationId])
  @@index([adminUserId])
  @@index([createdAt])
}

model Notification {
  id             String        @id @default(cuid())
  type           String
  title          String
  message        String
  consultationId String?
  isRead         Boolean       @default(false)

  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  createdAt      DateTime      @default(now())

  @@index([isRead])
  @@index([createdAt])
}